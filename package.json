{
  "name": "school-erp",
  "version": "0.1.0",
  "private": true,
  "description": "School ERP for the web and Windows. Google Sheets storage in v1, a database server later.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:env": "node scripts/create-env.mjs",
    "dev": "concurrently -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @school/api",
    "dev:web": "npm run dev -w @school/web",
    "dev:control": "npm run dev -w @school/control",
    "build:control": "npm run build -w @school/control",
    "start:control": "npm run start -w @school/control",
    "init:control": "npm run init -w @school/control --",
    "build": "npm run build -w @school/web",
    "start": "npm run start -w @school/api",
    "init:school": "npm run init -w @school/api --",
    "sheets:check": "npm run sheets:check -w @school/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop:dev": "npm run dev -w @school/desktop",
    "desktop:build": "npm run build -w @school/desktop",
    "e2e": "npm run build && npm run build:control && playwright test",
    "e2e:only": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
