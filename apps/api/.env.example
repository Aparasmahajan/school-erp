# School ERP API settings. Copy to .env (or run `npm run setup:env` from the repo root,
# which also generates SESSION_SECRET). Never commit .env.

# ── required ──
# Signs login sessions and invite links. 32+ random characters. The API refuses to start
# without it; there is no fallback.
SESSION_SECRET=

# ── storage ──
# file    = a JSON file on this machine (local development, or a single-laptop pilot)
# sheets  = Google Sheets, one spreadsheet per school (v1 production)
# memory  = nothing saved; for tests
STORAGE=file
DATA_FILE=.data/school.json

# Needed when STORAGE=sheets. Share the spreadsheet with the service-account email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the key on one line with literal \n sequences, inside double quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# How long reads are reused before asking Google again. This process is the only writer,
# so its own changes are always seen immediately; this only delays hand edits to the sheet.
SHEETS_CACHE_SECONDS=60

# ── web ──
# Where people open the app. Used in invite links and to check where requests come from.
PUBLIC_URL=http://localhost:5173
# Extra origins allowed to call the API with a bearer token (the Windows app).
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
# In production, serve the built web app from the API so both share one origin:
# WEB_DIST=../web/dist
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# ── reporting to the Control console (optional) ──
# The vendor's console gives each school these three values when it is onboarded. With
# them set, a worker thread sends this school's audit trail (actions, ids, counts; never
# names, phones or locations) and a health report every few minutes.
# To try it locally with both demos running (`npm run dev` and `npm run dev:control`),
# uncomment these; the demo key is refused in production:
# CONTROL_URL=http://localhost:8788
# CONTROL_SCHOOL_ID=sch_demo_sunrise
# CONTROL_INSTALL_KEY=ik_demo_local_only_never_use_in_production
# TELEMETRY_HEARTBEAT_SECONDS=300
# TELEMETRY_FLUSH_SECONDS=15

# ── development ──
# Loads a demo school (5 classes, 180 students, demo logins with password Demo@12345)
# into an EMPTY file/memory store on start. Refused when NODE_ENV=production.
DEMO_SEED=true
PORT=8787
