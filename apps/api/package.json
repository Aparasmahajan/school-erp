{
  "name": "@school/api",
  "version": "0.1.0",
  "private": true,
  "description": "School ERP API. The only part that touches storage.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "init": "tsx scripts/init.ts",
