    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@school/core": "*",
    "@school/server": "*",
    "hono": "^4.13.0",
    "jose": "^6.2.0",
    "tsx": "^4.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
