# Used by `vite --mode desktop` (the Windows app). Not secret.
VITE_TARGET=desktop
# Where the Windows app finds the API. Empty = same origin, which works in `tauri dev`
# because the dev window loads the Vite server and its /api proxy. For an installer you
# ship, set this to your hosted API, e.g. https://erp.yourschool.in
VITE_API_URL=
