# Control console settings. Copy to .env (or run `npm run setup:env` from the repo root,
# which creates it with a random secret). Never commit .env.

# Signs console logins and invite links. 32+ random characters. Different from any school's.
CONTROL_SESSION_SECRET=

# file = JSON file on this machine; sheets = the central "all schools" spreadsheet.
STORAGE=file
DATA_FILE=.data/control.json

# Needed when STORAGE=sheets: the Control console's OWN spreadsheet and service account.
# Never give a school's server these credentials: Sheets can't hide one school's rows from another.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SHEETS_CACHE_SECONDS=30

# Where the console is opened. Schools send their reports to this address too.
PUBLIC_URL=http://localhost:5174
# WEB_DIST=web/dist
# COOKIE_SECURE=true

# Dates in the console (activity grid, "today") use this time zone.
DISPLAY_TIMEZONE=Asia/Kolkata
# A school is "stale" after this long without a report, and "offline" after the next.
STALE_AFTER_MINUTES=20
OFFLINE_AFTER_MINUTES=120
# Keep one heartbeat per school per this many minutes as history (the latest is always kept).
HEARTBEAT_HISTORY_MINUTES=60

# Development only: loads six example schools and logins
# owner@control.demo / viewer@control.demo, password Demo@12345. Refused in production.
DEMO_SEED=true
PORT=8788
